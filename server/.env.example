# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/dwmt

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookies
COOKIE_SECURE=false

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Email (optional - if blank, emails are logged instead of sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DWMT <no-reply@dwmt.local>"

# Initial Super Admin (used by seed script)
SUPER_ADMIN_EMAIL=admin@dwmt.local
SUPER_ADMIN_PASSWORD=Admin@12345
SUPER_ADMIN_NAME=System Administrator
